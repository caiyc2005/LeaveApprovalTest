    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "员工列表";
}
@using LeaveApproval.DataModel;
@using LeaveApproval.Common;
@model PaginatedList<Staff>

<h2>@ViewData["Title"]</h2>
<p class="subtitle-c">可在本页面执行添加/删除/修改/查看员工信息</p>
<nav class="navbar navbar-light bg-light">
    <div class="container-fluid">
        <form asp-action="List" method="get" class="d-flex w-form" role="search">
            <input class="form-control me-2" type="search" name="s" value="@ViewData["keyWord"]" placeholder="输入员工姓名关键字" aria-label="Search"/>
            <button class="btn btn-danger wd-100" type="submit">搜索</button>
        </form>

        <a asp-action="Add" asp-route-returnUrl="@ViewData["returnUrl"]">添加员工</a>
    </div>
</nav>


<table class="table">
    <thead>
        <tr>
            <th>姓名</th>
            <th>性别</th>
            <th>年龄</th>
            <th>部门</th>
            <th>职位</th>
            <th>入职</th>
            <th>状态</th>
            <th>审批人</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.Sex==true ? "女" : "男")</td>
                <td>@item.Age</td>
                <td>@if (item.Department != null) { @item.Department.Name}</td>
                <td>@if (item.Position != null) { @item.Position.Name}</td>
                <td>@(item.Created?.ToShortDateString() ?? "")</td>
                @* <td>@item.Created.ToShortDateString()</td> *@
                <td>@(item.IsEnabled ? "在职":"离职")</td>
                <td>@(item.IsApprover ? "是":"否")</td>
                <td>
                    <a asp-controller="Staff"
                    asp-action="Edit"
                    asp-route-returnUrl="@ViewData["returnUrl"]"
                    asp-route-id="@item.Id"
                    
                    >编辑</a>

                    <a asp-controller="Staff"
                    asp-action="Delete"
                    asp-route-returnUrl="@ViewData["returnUrl"]"
                    asp-route-id="@item.Id"
                        onclick="return confirm('确认删除？')">
                    删除</a>

                    <a asp-controller="Staff"
                    asp-action="SetApprover"
                    asp-route-returnUrl="@ViewData["returnUrl"]"
                    asp-route-id="@item.Id">
                    @(item.IsApprover ? "取消审批人":"设为审批人")
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @prevDisabled">
            <a asp-action="List"
               asp-route-p="@(Model.PageIndex - 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">上一页</a>
        </li>

        <li class="page-item @nextDisabled">
            <a asp-action="List"
               asp-route-p="@(Model.PageIndex + 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">下一页</a>
        </li>
    </ul>
</nav>
