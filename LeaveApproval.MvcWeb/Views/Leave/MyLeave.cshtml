@{
    ViewData["Title"] = "我的请假单";
}
@using LeaveApproval.DataModel;
@using LeaveApproval.Common;
@model PaginatedList<Leaves>

<h2>@ViewData["Title"]</h2>
<p class="subtitle-c">可在本页面查看我的请假申请单</p>
<nav class="navbar navbar-light bg-light">
    <div class="container-fluid">
        <form asp-action="MyLeave" method="get" class="d-flex w-form" role="search">
            <input class="form-control me-2" type="search" placeholder="输入请假标题关键字" aria-label="Search" name="s" value="@ViewData["keyWord"]" />
            <select name="sp" class="form-select wd-100">
                @* @if (ViewData["IsApproval"]!.ToString() == "approved")
                {
                    <option selected value="Approved">已审批</option>
                    <option value="NotApproved">未审批</option>
                }
                else
                {
                    <option value="Approved">已审批</option>
                    <option selected value="NotApproved">未审批</option>
                } *@

                @{
                    var currentStatus = ViewData["IsApproval"]?.ToString() ?? "notapproved";
                }
                <option value="all" selected="@(currentStatus == "all")">全部</option>
                <option value="approved" selected="@(currentStatus == "approved")">已审批</option>
                <option value="notapproved" selected="@(currentStatus == "notapproved")">未审批</option>

            </select>&nbsp;&nbsp;
            <button class="btn btn-danger wd-100" type="submit">搜索</button>
        </form>
    </div>
</nav>

<table class="table">
    <thead>
        <tr>
            <th>标题</th>
            <th>申请人</th>
            <th>审批人</th>
            <th>开始时间</th>
            <th>结束时间</th>
            <th>审批状态</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        
        @foreach(var m in Model)
        {
            <tr>
                <td>@m.Title</td>
                <td>@m.ApplyPerson!.Name</td>
                <td>@m.ApprovalPerson!.Name</td>
                <td>@m.StartDateTime.ToShortDateString()</td>
                <td>@m.EndDateTime.ToShortDateString()</td>
                <td class="wd-120">
                    @((bool)m.IsApproved! ? "已审批" : "未审批")
                    @if ((bool)m.IsApproved)
                    {
                        <span class="text-danger">@(m.ApprovalResult ? "同意" : "拒绝")</span>
                    }
                </td>
                <td class="wd-60">
                    <a asp-controller="Leave"
                    asp-action="ViewLeave"
                    asp-route-returnUrl="@ViewData["returnUrl"]"
                    asp-route-id="@m.Id"
                    >
                    查看
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @prevDisabled">
            <a asp-action="MyLeave"
               asp-route-p="@(Model.PageIndex - 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">上一页</a>
        </li>

        <li class="page-item @nextDisabled">
            <a asp-action="MyLeave"
               asp-route-p="@(Model.PageIndex + 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">下一页</a>
        </li>
    </ul>
</nav>
