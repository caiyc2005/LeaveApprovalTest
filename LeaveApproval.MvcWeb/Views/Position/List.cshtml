    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "职位列表";
}
@using LeaveApproval.DataModel;
@using LeaveApproval.Common;
@model PaginatedList<Position>

<h2>
    @ViewData["Title"]
</h2>
<p class="subtitle-c">可在本页面执行添加/删除/修改/查看职位信息</p>


<!-- 显示提示消息 -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<nav class="navbar navbar-light bg-light">
    <div class="container-fluid">
        <form asp-action="List" method="get" class="d-flex w-form" role="search">
            <input class="form-control me-2" type="search" name="s" value="@ViewData["keyWord"]" placeholder="输入职位名称关键词" aria-label="Search"/>
            <button class="btn btn-danger wd-100" type="submit">搜索</button>
        </form>


        <!-- 导出按钮组 -->
        <div class="btn-group me-2" role="group">
            <a asp-action="ExportToExcel" asp-route-keyWord="@ViewData["keyWord"]" class="btn btn-success btn-sm">
                📊 导出全部
            </a>
            <button type="button" id="exportSelectedBtn" class="btn btn-info btn-sm" disabled>
                ✓ 导出选中
            </button>
        </div>


        <a asp-action="Add" asp-route-returnUrl="@ViewData["returnUrl"]">添加职位</a>
    </div>
</nav>

<table class="table">
    <thead>
        <tr>
            <th style="width: 40px;">
                <input type="checkbox" id="selectAll" />
            </th>

            <th>职位名称</th>
            <th>是否可用</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>

                <td class="text-center">
                    <input type="checkbox" class="positionCheckbox" value="@m.Id" />
                </td>

                <td>@m.Name</td>
                @* <td>@(m.IsEnabled ? "✔ 启用" : "✘ 禁用")</td> *@
                @* <td>@m.IsEnabled</td> *@
                <td>@Html.DisplayFor(p => m.IsEnabled)</td>
                <td>
                    <a 
                        asp-controller="Position"
                        asp-action="Edit" 
                        asp-route-id="@m.Id" 
                        asp-route-returnUrl="@ViewData["returnUrl"]">编辑</a>
                    <a 
                        asp-controller="Position"
                        asp-action="Delete" 
                        asp-route-id="@m.Id" 
                        asp-route-returnUrl="@ViewData["returnUrl"]"
                        onclick="return confirm('确定要删除吗？');">删除</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<nav aria-label="Page navigation">
    <ul class="pagination">
        <li class="page-item @prevDisabled">
            <a asp-action="List"
               asp-route-p="@(Model.PageIndex - 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">上一页</a>
        </li>

        <li class="page-item @nextDisabled">
            <a asp-action="List"
               asp-route-p="@(Model.PageIndex + 1)"
               asp-route-c="@ViewData["keyWord"]"
               class="page-link">下一页</a>
        </li>
    </ul>
</nav>


@section Scripts {
    <script>
        // 全选/取消全选
        $("#selectAll").change(function() {
            var isChecked = $(this).prop("checked");
            $(".positionCheckbox").prop("checked", isChecked);
            updateExportButton();
        });
        
        // 单个复选框变化
        $(".positionCheckbox").change(function() {
            updateExportButton();
            var allChecked = $(".positionCheckbox:checked").length === $(".positionCheckbox").length;
            $("#selectAll").prop("checked", allChecked);
        });
        
        // 更新导出按钮状态
        function updateExportButton() {
            var checkedCount = $(".positionCheckbox:checked").length;
            $("#exportSelectedBtn").prop("disabled", checkedCount === 0);
        }
        
        // 导出选中的职位
        $("#exportSelectedBtn").click(function() {
            var selectedIds = [];
            $(".positionCheckbox:checked").each(function() {
                selectedIds.push($(this).val());
            });
            
            if (selectedIds.length === 0) {
                alert("请至少选择一个职位");
                return;
            }
            
            var exportBtn = $(this);
            var originalText = exportBtn.html();
            exportBtn.html("⏳ 导出中...").prop("disabled", true);
            
            var form = $('<form action="@Url.Action("ExportSelected")" method="post" target="_blank"></form>');
            $.each(selectedIds, function(i, id) {
                form.append($('<input type="hidden" name="selectedIds" />').val(id));
            });
            $('body').append(form);
            form.submit();
            form.remove();
            
            setTimeout(function() {
                exportBtn.html(originalText).prop("disabled", false);
            }, 1000);
        });
    </script>
}