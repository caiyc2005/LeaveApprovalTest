@{
    ViewData["Title"] = "重置密码";
}
@model ResetPasswordViewModel
<h2>@ViewData["Title"]</h2>
<p class="subtitle-c">请按照要求输入新密码(要求包含数字、大写字母、特殊符号)。</p>
<form asp-action="ResetPassword" asp-route-returnUrl="@ViewData["returnUrl"]" method="post" class="w-form">
    <hr />
    <div class="text-danger">@ViewData["Message"]</div>
    <div class="mb-3 wd-300">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" disabled value="@User.Identity?.Name" class="form-control"/>
    </div>

    <div class="mb-3 wd-300">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">提交</button>
        <a class="btn btn-secondary" href="@ViewData["returnUrl"]">返回</a>
    </div>
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
